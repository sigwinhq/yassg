<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>

    <title>{% block title %}{% endblock %}</title>

    {% block social_image %}{% endblock %}
    {#
        TODO: must be the correct address

        Revamp when we have a full Docker build setup
    #}
    {% set social_image_url = "http://app:9988"~block('social_image') %}
    {% if social_image_url is not empty %}
    <meta property="og:image" content="{{ yassg_thumbnail(social_image_url) }}">
    <meta name="twitter:image" content="{{ yassg_thumbnail(social_image_url) }}">
    <meta name="twitter:card" content="summary_large_image">
    {% endif %}

    {{ encore_entry_link_tags('app') }}
</head>
<body>

{% block body %}{% endblock %}

{{ encore_entry_script_tags('app') }}
</body>
</html>
